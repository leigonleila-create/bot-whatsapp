# Tu numero de WhatsApp con codigo de pais, sin "+" ni espacios.
# Ejemplo Argentina (11 1234 5678): 5491112345678
PHONE_NUMBER=

# Textos que usa el bot para responder (opcional, tiene valores por defecto)
