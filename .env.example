# Copia estas variables en Railway (pestaña Variables), no en este archivo.
# No subas un archivo .env real a GitHub.

# Clave de Groq (gratis) para que el bot responda con IA.
# Se consigue en https://console.groq.com/keys
GROQ_API_KEY=

# Modelo de Groq a usar (opcional, tiene un valor por defecto).
GROQ_MODEL=openai/gpt-oss-120b

# Textos que usa el bot (opcional, tiene valores por defecto pensados para Corpore)
BUSINESS_NAME=Corpore
SERVICES_TEXT=Masaje completo, masaje relajante, reflexologia y depilacion.
PAYMENT_TEXT=Efectivo o transferencia.
